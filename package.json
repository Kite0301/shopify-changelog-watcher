{
  "name": "shopify-changelog-watcher",
  "version": "1.0.0",
  "description": "Automated Shopify changelog monitoring and analysis tool for Japanese merchants and partners",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fetch": "tsx src/scripts/fetch-rss.ts",
    "analyze": "tsx src/scripts/analyze.ts",
    "compare:models": "tsx src/scripts/compare-models.ts",
    "report:weekly": "tsx src/scripts/generate-weekly-report.ts",
    "slides:pdf": "marp --theme themes/shopify-changelog.css --pdf --allow-local-files",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "shopify",
    "changelog",
    "rss",
    "automation",
    "ai-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "dotenv": "^18.0.4",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
